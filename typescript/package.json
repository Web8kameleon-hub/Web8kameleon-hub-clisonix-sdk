{
  "name": "@clisonix/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript client for the public Clisonix API",
  "main": "./dist/clisonix-sdk.js",
  "module": "./dist/clisonix-sdk.mjs",
  "types": "./dist/clisonix-sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/clisonix-sdk.d.ts",
      "import": "./dist/clisonix-sdk.mjs",
      "require": "./dist/clisonix-sdk.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup clisonix-sdk.ts --format cjs,esm --dts --clean --target node18",
    "dev": "tsup clisonix-sdk.ts --format cjs,esm --dts --watch --target node18",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "clisonix",
    "api",
    "sdk",
    "neural",
    "eeg",
    "typescript"
  ],
  "author": "Clisonix Cloud <support@clisonix.cloud>",
  "license": "MIT",
  "homepage": "https://clisonix.com/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Web8kameleon-hub/Web8kameleon-hub-clisonix-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/Web8kameleon-hub/Web8kameleon-hub-clisonix-sdk/issues"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
